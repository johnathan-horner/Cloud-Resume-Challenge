# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js development files #
##############################
node_modules/
package.json
package-lock.json
*.config.js
npm-debug.log*
# Terraform: state lives in the S3 backend (see infra/provider.tf). Never commit it.
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
*.tfplan
crash.log
